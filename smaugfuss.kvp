# ==============================================================
#  GenericModule.kvp — SmaugFUSS MUD Server
#  Place this file in your AMP instance's data directory, or
#  include it in a template repository for ADS deployment.
# ==============================================================

# --------------------------------------------------------------
# Application
# --------------------------------------------------------------

# Human-readable name shown in AMP
App.DisplayName=SmaugFUSS MUD

# The instance root as seen inside the container is always /AMP/
App.RootDir=./
App.WorkingDir=./

# Linux only — the smaug binary is placed here by the build script
App.ExecutableLinux=./smaug

# Port passed as the only argument to the smaug binary
App.CommandLineArgs={{$ApplicationPort1}}

# MUD telnet port (players connect here)
App.ApplicationPort1=4000

# AMP monitors the 'smaug' process for CPU/RAM metrics and shutdown
App.MonitorChildProcessName=^.*smaug.*$

# How AMP talks to the running server
App.AdminMethod=STDIO
App.HasWriteableConsole=True
App.HasReadableConsole=True

# Send 'shutdown' to the MUD's console to stop it gracefully
App.ExitMethod=String
App.ExitString=shutdown

# Maximum simultaneous player connections (informational)
App.MaxUsers=100

# --------------------------------------------------------------
# Update Sources
# Called when the user clicks "Update" in the AMP panel.
# Stage 1: Run the build script (download latest release + compile)
# Stage 2: Ensure the smaug binary is marked executable
# --------------------------------------------------------------

App.UpdateSources=[{"UpdateStageName": "Download and Build SmaugFUSS", "UpdateSourcePlatform": "Linux", "UpdateSource": "Executable", "UpdateSourceData": "/usr/local/bin/smaugfuss-build.sh"}, {"UpdateStageName": "Mark binary executable", "UpdateSourcePlatform": "Linux", "UpdateSource": "SetExecutableFlag", "UpdateSourceArgs": "./smaug"}]

# --------------------------------------------------------------
# Console parsing
# AMP uses these regexes to detect server state and activity.
# Adjust AppReadyRegex if SmaugFUSS prints a different ready line.
# --------------------------------------------------------------

# Change server state from 'Starting' → 'Running' once this line appears
Console.AppReadyRegex=^.*Booting.*$

# Detect player connections (Smaug logs: "New connection from <ip>")
Console.UserJoinRegex=^.*New connection from (?<username>.+?).*$

# Detect player disconnections
Console.UserLeaveRegex=^.*Closing link: (?<username>.+?).*$

# --------------------------------------------------------------
# Meta
# --------------------------------------------------------------

Meta.DisplayName=SmaugFUSS MUD
Meta.Author=Custom

# Linux only — this image has no Windows equivalent
Meta.OS=2

# Unique ID for this configuration (regenerate if forking)
Meta.AppConfigId=a1b2c3d4-e5f6-7890-abcd-ef1234567890

# Link to the project homepage
Meta.URL=https://smaugmuds.afkmods.com/

Meta.DisplayImageSource=none:

# Replace 'yourname/smaugfuss-amp' with your actual Docker Hub image name
Meta.SpecificDockerImage=davidatftd/smaugamp

# This configuration requires Docker on Linux to function correctly
Meta.ContainerPolicy=RequiredOnLinux
